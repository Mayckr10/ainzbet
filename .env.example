# Token do bot (BotFather). NUNCA publique este valor.
BOT_TOKEN=
# Seu Telegram ID: recebe avisos de compras/doações e pode usar /admin e /reembolso
ADMIN_ID=
# Postgres (no Railway use a variável de referência ${{Postgres.DATABASE_URL}})
DATABASE_URL=postgres://postgres:postgres@localhost:5433/cassino
# URL pública HTTPS do serviço (ex.: https://ainzbet.up.railway.app). Vazio = bot em long polling (dev)
PUBLIC_URL=
# Nome curto do Mini App criado no BotFather (/newapp). Vazio = usa o Main Mini App do bot
APP_SHORT_NAME=
# Segredo aleatório para validar o webhook do Telegram
WEBHOOK_SECRET=
# Economia (opcional)
STARTING_BALANCE=10000
DAILY_BONUS=1000
RESCUE_BONUS=500
MIN_BET=1
MAX_BET=100000
# Desenvolvimento: DEV_AUTH=1 permite abrir no navegador com ?dev=123 (nunca em produção)
DEV_AUTH=
