{
  "name": "ainzbet-telegram",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Mini App de cassino com fichas virtuais para Telegram (modo inline)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/src/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "npm run build:web && npm run build:api",
    "build:web": "vite build --config web/vite.config.ts",
    "build:api": "tsc -p server/tsconfig.json",
    "start": "node server/dist/index.js",
    "typecheck": "tsc -p server/tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "rtp": "tsx scripts/rtp.ts",
    "localdb": "tsx scripts/localdb.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/static": "^10.1.6",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "dotenv": "^18.0.8",
    "fastify": "^5.12.7",
    "framer-motion": "^14.3.0",
    "grammy": "^1.46.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "^8.3.4"
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "embedded-postgres": "^18.4.0-beta.17",
    "tsx": "^4.20.0"
  }
}
